{
  "name": "@ordax/intelligence",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Portable Intelligence core with canonical OS contract injection.",
  "exports": {
    ".": "./src/index.mjs"
  },
  "scripts": {
